\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{custom}[2024/05/20 Custom styles for AI Guide]

\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage[indonesian]{babel}
\RequirePackage{geometry}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{listings}
\RequirePackage{tcolorbox}
\RequirePackage{hyperref}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{tocloft}
\RequirePackage{tikz}
\usetikzlibrary{shapes.geometric, arrows}

% --- Color Definitions ---
\definecolor{primary}{RGB}{0, 102, 204}
\definecolor{secondary}{RGB}{204, 102, 0}
\definecolor{codebg}{RGB}{245, 245, 245}
\definecolor{promptbg}{RGB}{240, 248, 255}
\definecolor{exercisebg}{RGB}{255, 250, 240}

% --- Page Geometry ---
\geometry{
    a4paper,
    top=2.5cm,
    bottom=2.5cm,
    left=3cm,
    right=2.5cm
}

% --- Hyperref Setup ---
\hypersetup{
    colorlinks=true,
    linkcolor=primary,
    filecolor=magenta,
    urlcolor=cyan,
}

% --- Listings (Code) Setup ---
\lstset{
    backgroundcolor=\color{codebg},
    basicstyle=\ttfamily\small,
    breakatwhitespace=false,
    breaklines=true,
    captionpos=b,
    keepspaces=true,
    numbers=left,
    numbersep=5pt,
    showspaces=false,
    showstringspaces=false,
    showtabs=false,
    tabsize=2,
    frame=single,
    rulecolor=\color{gray}
}

\lstnewenvironment{codeblock}[1][]
{
    \lstset{
        backgroundcolor=\color{codebg},
        basicstyle=\ttfamily\small,
        breaklines=true,
        frame=single,
        #1
    }
}{}

% --- Custom Boxes ---

% 1. Prompt Box (Blue)
\newtcolorbox{promptbox}[1][]{
    colback=promptbg,
    colframe=primary,
    fonttitle=\bfseries,
    title=Contoh Prompt,
    #1
}

% 2. Exercise Box (Orange)
\newtcolorbox{exercisebox}[1][]{
    colback=exercisebg,
    colframe=secondary,
    fonttitle=\bfseries,
    title=Latihan Praktis,
    #1
}

% 3. Tip Box (Green)
\newtcolorbox{tipbox}[1][]{
    colback=white,
    colframe=green!60!black,
    fonttitle=\bfseries,
    title=Tips Pro,
    #1
}

% --- Header & Footer ---
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE,RO]{\thepage}
\fancyhead[RE]{\leftmark}
\fancyhead[LO]{\rightmark}

% --- Section Formatting ---
\titleformat{\chapter}[display]
  {\normalfont\huge\bfseries\color{primary}}{\chaptertitlename\ \thechapter}{20pt}{\Huge}
\titlespacing*{\chapter}{0pt}{50pt}{40pt}

\endinput
